{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=bibliotheca.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kiosk": {
    "BranchName": "Bibliotheca Library",
    "IdleTimeoutSeconds": 90,
    "IdleWarningSeconds": 15,
    "LoanDays": 14,
    "MaxActiveLoans": 5,
    "BlockWhenOverdue": true,
    "MaxUnpaidFines": 10.0,
    "MaxFailedCardAttempts": 5,
    "LockoutSeconds": 60,
    "EnableCameraScan": true
  }
}