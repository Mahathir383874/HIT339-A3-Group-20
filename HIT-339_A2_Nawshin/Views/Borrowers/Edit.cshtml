@model Bibliotheca.Models.Entities.Borrower
@{
    ViewData["Title"] = $"Edit Borrower - {Model.FullName}";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-lg-8">
        <div class="card-custom p-4 p-md-5 shadow-sm">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-4">
                <div>
                    <span class="badge role-reception fw-bold text-uppercase px-2 py-1 mb-1">
                        <i class="bi bi-pencil me-1"></i> Edit Record
                    </span>
                    <h3 class="fw-bold mb-0">Modify Borrower Details</h3>
                </div>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Profile
                </a>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="RegisteredDate" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="FirstName" class="form-label fw-semibold small"></label>
                        <input asp-for="FirstName" class="form-control" required />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="LastName" class="form-label fw-semibold small"></label>
                        <input asp-for="LastName" class="form-control" required />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="CardNumber" class="form-label fw-semibold small"></label>
                        <input asp-for="CardNumber" class="form-control font-monospace" required />
                        <span asp-validation-for="CardNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="IsActive" class="form-label fw-semibold small">Account Status</label>
                        <select asp-for="IsActive" class="form-select">
                            <option value="true">Active Membership</option>
                            <option value="false">Suspended / Inactive</option>
                        </select>
                        <span asp-validation-for="IsActive" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small"></label>
                        <input asp-for="Email" class="form-control" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold small"></label>
                        <input asp-for="Phone" class="form-control" required />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Address" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom px-4">
                        <i class="bi bi-save me-1"></i> Update Borrower
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
