@model Bibliotheca.Models.Entities.Item
@{
    ViewData["Title"] = $"{Model.Name} - Item Details";
    var defaultImg = Model.ItemType switch
    {
        "Book" => "https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=600&q=80",
        "Music" => "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=600&q=80",
        "Toy" => "https://images.unsplash.com/photo-1585366119957-e9730b6d0f60?w=600&q=80",
        _ => "https://images.unsplash.com/photo-1532012164546-f432f2e3edd4?w=600&q=80"
    };

    var statusBadgeClass = Model.Status switch
    {
        ItemStatus.Available => "badge-available",
        ItemStatus.Borrowed => "badge-borrowed",
        ItemStatus.Damaged => "badge-damaged",
        ItemStatus.Destroyed => "badge-destroyed",
        _ => "badge-secondary"
    };
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-lg-10">
        <div class="mb-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-custom">
                <i class="bi bi-arrow-left me-1"></i> Back to Collection
            </a>
        </div>

        <div class="card-custom p-4 p-md-5 shadow-sm">
            <div class="row g-4">
                <!-- Left: Graphic / Cover image -->
                <div class="col-12 col-md-5 col-lg-4 text-center">
                    <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? defaultImg : Model.ImageUrl)"
                         alt="@Model.Name"
                         class="img-fluid rounded-3 shadow-md border w-100"
                         style="max-height: 380px; object-fit: cover;"
                         onerror="this.src='@defaultImg'" />

                    <div class="mt-3">
                        <span class="badge-code fs-6 px-3 py-2">
                            <i class="bi bi-upc-scan me-1"></i> @Model.LibraryCode
                        </span>
                    </div>
                </div>

                <!-- Right: Detailed Specifications -->
                <div class="col-12 col-md-7 col-lg-8">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="badge badge-type py-1 px-2">
                            @if (Model is Book) { <span>📚 Book</span> }
                            else if (Model is Music) { <span>🎵 Music Album</span> }
                            else if (Model is Toy) { <span>🧩 Toy / Game</span> }
                        </span>
                        <span class="badge-status @statusBadgeClass">
                            <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> @Model.Status
                        </span>
                    </div>

                    <h2 class="fw-bold mb-3">@Model.Name</h2>

                    @{
                        var lending = ViewBag.Lending as ItemLendingState;
                    }
                    <div class="mb-3 small text-muted d-flex flex-wrap gap-3">
                        <span><i class="bi bi-building me-1"></i><strong>Branch:</strong> @(Model.Branch?.Name ?? "Not assigned")</span>
                        @if (lending != null && lending.InTransfer)
                        {
                            <span><i class="bi bi-truck me-1"></i>Moving to @(lending.TransferDestination ?? "another branch")</span>
                        }
                        @if (lending != null && lending.QueueLength > 0)
                        {
                            <span><i class="bi bi-bookmark-star me-1"></i>@lending.QueueLength @(lending.QueueLength == 1 ? "person is" : "people are") waiting for this item@(lending.OnHoldShelf ? " (on the hold shelf)" : "")</span>
                        }
                    </div>

                    @if (Model.Status != ItemStatus.Destroyed && (Model.Status != ItemStatus.Available || (lending != null && (lending.InTransfer || lending.QueueLength > 0))))
                    {
                        <div class="alert alert-info py-2 small">
                            <i class="bi bi-info-circle me-1"></i>
                            This item can't be borrowed right now. Place a hold at a self-service kiosk with your library card, or ask at the front desk, and you will be notified when it is ready.
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="bg-light p-3 rounded-3 mb-4 text-secondary">
                            <h6 class="fw-bold text-dark mb-1">Overview</h6>
                            <p class="mb-0">@Model.Description</p>
                        </div>
                    }

                    <h5 class="fw-bold border-bottom pb-2 mb-3">Item Specifications</h5>

                    <div class="row g-3 mb-4">
                        @if (Model is Book book)
                        {
                            <div class="col-6 col-sm-4">
                                <div class="text-muted small">Author</div>
                                <div class="fw-bold text-dark">@book.Author</div>
                            </div>
                            <div class="col-6 col-sm-4">
                                <div class="text-muted small">Genre</div>
                                <div class="fw-bold text-dark">@book.Genre</div>
                            </div>
                            @if (!string.IsNullOrEmpty(book.ISBN))
                            {
                                <div class="col-6 col-sm-4">
                                    <div class="text-muted small">ISBN</div>
                                    <div class="fw-bold text-dark">@book.ISBN</div>
                                </div>
                            }
                            @if (book.PageCount.HasValue)
                            {
                                <div class="col-6 col-sm-4">
                                    <div class="text-muted small">Pages</div>
                                    <div class="fw-bold text-dark">@book.PageCount pages</div>
                                </div>
                            }
                        }
                        else if (Model is Music music)
                        {
                            <div class="col-6 col-sm-4">
                                <div class="text-muted small">Artist / Band</div>
                                <div class="fw-bold text-dark">@music.Artist</div>
                            </div>
                            @if (music.ReleaseYear.HasValue)
                            {
                                <div class="col-6 col-sm-4">
                                    <div class="text-muted small">Release Year</div>
                                    <div class="fw-bold text-dark">@music.ReleaseYear</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(music.RecordLabel))
                            {
                                <div class="col-6 col-sm-4">
                                    <div class="text-muted small">Record Label</div>
                                    <div class="fw-bold text-dark">@music.RecordLabel</div>
                                </div>
                            }
                            @if (music.DurationMinutes.HasValue)
                            {
                                <div class="col-6 col-sm-4">
                                    <div class="text-muted small">Runtime</div>
                                    <div class="fw-bold text-dark">@music.DurationMinutes minutes</div>
                                </div>
                            }
                        }
                        else if (Model is Toy toy)
                        {
                            <div class="col-6 col-sm-4">
                                <div class="text-muted small">Toy Type</div>
                                <div class="fw-bold text-dark">@toy.ToyType</div>
                            </div>
                            <div class="col-6 col-sm-4">
                                <div class="text-muted small">Target Age Group</div>
                                <div class="fw-bold text-dark">@toy.RecommendedAge</div>
                            </div>
                            @if (!string.IsNullOrEmpty(toy.Manufacturer))
                            {
                                <div class="col-6 col-sm-4">
                                    <div class="text-muted small">Manufacturer</div>
                                    <div class="fw-bold text-dark">@toy.Manufacturer</div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(toy.SafetyWarning))
                            {
                                <div class="col-12">
                                    <div class="alert alert-warning py-2 px-3 small mb-0">
                                        <i class="bi bi-shield-exclamation me-1"></i> <strong>Safety Note:</strong> @toy.SafetyWarning
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <!-- Staff Action Shortcuts if logged in -->
                    @if (User.IsInRole("Reception") || User.IsInRole("Admin"))
                    {
                        <div class="p-3 bg-light rounded-3 border d-flex flex-wrap gap-2 align-items-center justify-content-between mt-4">
                            <div>
                                <span class="fw-bold small text-muted text-uppercase">Staff Quick Actions:</span>
                            </div>
                            <div class="d-flex gap-2">
                                @if (Model.Status == ItemStatus.Available)
                                {
                                    <a asp-controller="Loans" asp-action="Issue" asp-route-libraryCode="@Model.LibraryCode" class="btn btn-sm btn-success">
                                        <i class="bi bi-box-arrow-right me-1"></i> Issue to Borrower
                                    </a>
                                }
                                @if (Model.Status != ItemStatus.Destroyed)
                                {
                                    <a asp-controller="Reservations" asp-action="Create" asp-route-libraryCode="@Model.LibraryCode" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-bookmark-star me-1"></i> Place Hold
                                    </a>
                                }
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-controller="Items" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil me-1"></i> Edit Item
                                    </a>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
