@model Bibliotheca.Models.ViewModels.NotificationListViewModel
@using Bibliotheca.Models.Enums
@{
    ViewData["Title"] = "Notifications";
    string Label(NotificationType t) => t switch
    {
        NotificationType.Borrowed => "Loan confirmation",
        NotificationType.DueSoon => "Due soon",
        NotificationType.Overdue => "Overdue",
        NotificationType.FineIssued => "Fine issued",
        NotificationType.FinePaid => "Fine paid",
        NotificationType.ReservationPlaced => "Hold placed",
        NotificationType.ReservationReady => "Hold ready",
        _ => "Hold cancelled"
    };
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <span class="badge role-manager mb-1"><i class="bi bi-envelope-paper me-1"></i> Simulated Notifications</span>
        <h2 class="fw-bold mb-0">Notification Log</h2>
        <p class="text-muted small mb-0">Borrow confirmations, due-date reminders, fines and reservation messages. Messages are recorded here instead of being sent through a live e-mail / SMS gateway.</p>
    </div>
    <form asp-action="RunReminders" method="post">
        <button type="submit" class="btn btn-primary-custom"><i class="bi bi-bell me-1"></i> Check due dates now</button>
    </form>
</div>

<div class="row g-2 mb-3">
    @foreach (var type in Enum.GetValues<NotificationType>())
    {
        var n = Model.CountsByType.TryGetValue(type, out var c) ? c : 0;
        <div class="col-6 col-md-3 col-xl">
            <a asp-action="Index" asp-route-type="@type" class="text-decoration-none">
                <div class="card-custom p-2 text-center @(Model.Type == type ? "border-primary" : "")">
                    <div class="fw-bold fs-5 text-dark">@n</div>
                    <div class="small text-muted">@Label(type)</div>
                </div>
            </a>
        </div>
    }
</div>

<div class="card-custom p-3 mb-3">
    <form asp-action="Index" method="get" class="row g-2 align-items-end">
        <div class="col-12 col-md-3">
            <select name="type" class="form-select form-select-sm" aria-label="Notification type">
                <option value="">All types</option>
                @foreach (var type in Enum.GetValues<NotificationType>())
                {
                    <option value="@type" selected="@(Model.Type == type)">@Label(type)</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-6">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Search by borrower, card number or message" />
                <button type="submit" class="btn btn-primary-custom">Filter</button>
                <a asp-action="Index" class="btn btn-outline-custom">Clear</a>
            </div>
        </div>
    </form>
</div>

<div class="small text-muted mb-2">
    Showing @Model.Rows.Count of @Model.TotalCount message(s)@(Model.TotalCount > NotificationListViewModel.MaxRows ? " (most recent " + NotificationListViewModel.MaxRows + ")" : "")
</div>

<div class="card-custom p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>When (UTC)</th>
                    <th>Type</th>
                    <th>To</th>
                    <th>Message</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Rows.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            <i class="bi bi-envelope fs-2 d-block mb-2"></i>
                            No notifications match this view.
                        </td>
                    </tr>
                }
                @foreach (var n in Model.Rows)
                {
                    <tr>
                        <td class="small text-nowrap">@n.CreatedDate.ToString("d MMM yyyy HH:mm")</td>
                        <td>
                            <span class="badge bg-light text-dark border">@Label(n.Type)</span>
                            <div class="small text-muted"><i class="bi @(n.Channel == NotificationChannel.Sms ? "bi-phone" : "bi-envelope") me-1"></i>@n.Channel</div>
                        </td>
                        <td>
                            <div class="fw-semibold">@(n.Borrower?.FullName ?? "(removed)")</div>
                            <div class="small text-muted">@n.Recipient</div>
                        </td>
                        <td>
                            <div class="fw-semibold">@n.Subject</div>
                            <div class="small text-muted">@n.Message</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
