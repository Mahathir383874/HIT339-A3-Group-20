@model Bibliotheca.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Staff Login";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card-custom p-4 p-md-5 shadow-lg">
            <div class="text-center mb-4">
                <div class="d-inline-flex p-3 rounded-circle bg-primary bg-opacity-10 text-primary mb-3">
                    <i class="bi bi-shield-lock-fill fs-2"></i>
                </div>
                <h3 class="fw-bold">Staff Authentication</h3>
                <p class="text-muted small">Sign in to access library management tools based on your assigned staff role.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 small" asp-validation-summary="All"></div>
            }

            <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold small"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-envelope text-muted"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="name@bibliotheca.com" required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold small"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-key text-muted"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-4">
                    <input class="form-check-input" asp-for="RememberMe" />
                    <label class="form-check-label small" asp-for="RememberMe">
                        Keep me signed in on this workstation
                    </label>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 py-2 mb-3">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                </button>
            </form>

            <div class="text-center mt-4 pt-2 border-top">
                <a asp-controller="Catalog" asp-action="Index" class="text-decoration-none small text-muted">
                    <i class="bi bi-arrow-left me-1"></i> Back to Public Catalog
                </a>
            </div>
        </div>
    </div>
</div>
