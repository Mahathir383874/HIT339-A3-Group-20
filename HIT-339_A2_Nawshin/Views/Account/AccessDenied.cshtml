@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card-custom p-5">
            <div class="d-inline-flex p-4 rounded-circle bg-danger bg-opacity-10 text-danger mb-4">
                <i class="bi bi-shield-slash-fill fs-1"></i>
            </div>
            <h2 class="fw-bold mb-2">Access Restricted</h2>
            <p class="text-muted mb-4">
                You do not have the required permissions to access this specific module. Each role (Admin, Reception, Manager) is segregated to access functions relevant to its responsibilities.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-custom">
                    <i class="bi bi-search me-1"></i> Public Catalog
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary-custom">
                    <i class="bi bi-arrow-repeat me-1"></i> Switch Account
                </a>
            </div>
        </div>
    </div>
</div>
