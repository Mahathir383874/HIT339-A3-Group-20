@model Bibliotheca.Models.Entities.Item
@{
    ViewData["Title"] = $"Admin Item Details - {Model.Name}";
    var queue = (ViewBag.Queue as IEnumerable<ReservationRow>) ?? Enumerable.Empty<ReservationRow>();
    var transfers = (ViewBag.Transfers as IEnumerable<BranchTransfer>) ?? Enumerable.Empty<BranchTransfer>();
    var statusBadgeClass = Model.Status switch
    {
        ItemStatus.Available => "badge-available",
        ItemStatus.Borrowed => "badge-borrowed",
        ItemStatus.Damaged => "badge-damaged",
        ItemStatus.Destroyed => "badge-destroyed",
        _ => "badge-secondary"
    };
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <span class="badge role-admin mb-1"><i class="bi bi-shield-lock-fill me-1"></i> Admin Record</span>
        <h2 class="fw-bold mb-0">@Model.Name</h2>
        <span class="badge-code mt-1">@Model.LibraryCode</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-custom">
            <i class="bi bi-pencil me-1"></i> Edit Item
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
            <i class="bi bi-trash me-1"></i> Delete
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- Specifications Card -->
    <div class="col-12 col-lg-7">
        <div class="card-custom p-4 h-100">
            <h5 class="fw-bold border-bottom pb-2 mb-3">Item Metadata</h5>
            
            <div class="row g-3 mb-4">
                <div class="col-6 col-sm-4">
                    <div class="text-muted small">Status</div>
                    <div><span class="badge-status @statusBadgeClass">@Model.Status</span></div>
                </div>
                <div class="col-6 col-sm-4">
                    <div class="text-muted small">Category</div>
                    <div class="fw-bold text-dark">@Model.ItemType</div>
                </div>
                <div class="col-6 col-sm-4">
                    <div class="text-muted small">Replacement Cost</div>
                    <div class="fw-bold text-dark">$@Model.ReplacementCost.ToString("F2")</div>
                </div>
                <div class="col-6 col-sm-4">
                    <div class="text-muted small">Date Registered</div>
                    <div class="fw-bold text-dark">@Model.CreatedDate.ToString("d MMM yyyy")</div>
                </div>
                <div class="col-6 col-sm-4">
                    <div class="text-muted small">Branch</div>
                    <div class="fw-bold text-dark">@(Model.Branch?.Name ?? "Not assigned")</div>
                </div>

                @if (Model is Book book)
                {
                    <div class="col-6 col-sm-4">
                        <div class="text-muted small">Author</div>
                        <div class="fw-bold text-dark">@book.Author</div>
                    </div>
                    <div class="col-6 col-sm-4">
                        <div class="text-muted small">Genre</div>
                        <div class="fw-bold text-dark">@book.Genre</div>
                    </div>
                    <div class="col-6 col-sm-4">
                        <div class="text-muted small">ISBN</div>
                        <div class="fw-bold font-monospace">@book.ISBN</div>
                    </div>
                    <div class="col-6 col-sm-4">
                        <div class="text-muted small">Pages</div>
                        <div class="fw-bold text-dark">@book.PageCount</div>
                    </div>
                }
                else if (Model is Music music)
                {
                    <div class="col-6 col-sm-4">
                        <div class="text-muted small">Artist</div>
                        <div class="fw-bold text-dark">@music.Artist</div>
                    </div>
                    <div class="col-6 col-sm-4">
                        <div class="text-muted small">Release Year</div>
                        <div class="fw-bold text-dark">@music.ReleaseYear</div>
                    </div>
                    <div class="col-6 col-sm-4">
                        <div class="text-muted small">Record Label</div>
                        <div class="fw-bold text-dark">@music.RecordLabel</div>
                    </div>
                    <div class="col-6 col-sm-4">
                        <div class="text-muted small">Duration</div>
                        <div class="fw-bold text-dark">@music.DurationMinutes mins</div>
                    </div>
                }
                else if (Model is Toy toy)
                {
                    <div class="col-6 col-sm-4">
                        <div class="text-muted small">Toy Category</div>
                        <div class="fw-bold text-dark">@toy.ToyType</div>
                    </div>
                    <div class="col-6 col-sm-4">
                        <div class="text-muted small">Recommended Age</div>
                        <div class="fw-bold text-dark">@toy.RecommendedAge</div>
                    </div>
                    <div class="col-6 col-sm-4">
                        <div class="text-muted small">Manufacturer</div>
                        <div class="fw-bold text-dark">@toy.Manufacturer</div>
                    </div>
                    <div class="col-12">
                        <div class="text-muted small">Safety Warning</div>
                        <div class="alert alert-warning py-1 px-2 small mb-0">@toy.SafetyWarning</div>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <h6 class="fw-bold text-muted small text-uppercase">Description</h6>
                <p class="text-secondary bg-light p-3 rounded">@Model.Description</p>
            }
        </div>
    </div>

    <!-- Loan History for this Item -->
    <div class="col-12 col-lg-5">
        <div class="card-custom p-4 h-100">
            <h5 class="fw-bold border-bottom pb-2 mb-3">
                <i class="bi bi-clock-history me-1 text-primary"></i> Circulation History
            </h5>

            @if (!Model.Loans.Any())
            {
                <p class="text-muted small text-center py-4">No borrowing transactions recorded for this item yet.</p>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var loan in Model.Loans.OrderByDescending(l => l.BorrowDate))
                    {
                        <div class="list-group-item px-0 py-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-dark">@loan.Borrower?.FullName</span>
                                <span class="badge @(loan.Status == LoanStatus.Returned ? "bg-success" : loan.Status == LoanStatus.Overdue ? "bg-danger" : "bg-primary")">
                                    @loan.Status
                                </span>
                            </div>
                            <div class="small text-muted">
                                <div>Borrowed: @loan.BorrowDate.ToString("d MMM yyyy")</div>
                                <div>Due: @loan.DueDate.ToString("d MMM yyyy")</div>
                                @if (loan.ReturnDate.HasValue)
                                {
                                    <div>Returned: @loan.ReturnDate.Value.ToString("d MMM yyyy")</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <!-- Hold queue -->
    <div class="col-12 col-lg-6">
        <div class="card-custom p-4 h-100">
            <h5 class="fw-bold border-bottom pb-2 mb-3">
                <i class="bi bi-bookmark-star me-1 text-primary"></i> Hold Queue
            </h5>
            @if (!queue.Any())
            {
                <p class="text-muted small text-center py-3 mb-0">Nobody is waiting for this item.</p>
            }
            else
            {
                <ol class="list-group list-group-numbered list-group-flush">
                    @foreach (var hold in queue)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0">
                            <div class="ms-2 me-auto">
                                <div class="fw-semibold">@hold.BorrowerName <span class="badge bg-light text-secondary border font-monospace">@hold.CardNumber</span></div>
                                <div class="small text-muted">Placed @hold.CreatedDate.ToString("d MMM yyyy") @(string.IsNullOrEmpty(hold.PlacedVia) ? "" : "via " + hold.PlacedVia)</div>
                            </div>
                            <span class="badge @(hold.Status == ReservationStatus.Ready ? "bg-success" : "bg-secondary")">@(hold.Status == ReservationStatus.Ready ? "Ready" : "Waiting")</span>
                        </li>
                    }
                </ol>
            }
            <div class="mt-3">
                <a asp-controller="Reservations" asp-action="Create" asp-route-libraryCode="@Model.LibraryCode" class="btn btn-sm btn-outline-custom">
                    <i class="bi bi-plus-circle me-1"></i> Place a hold
                </a>
            </div>
        </div>
    </div>

    <!-- Transfer history -->
    <div class="col-12 col-lg-6">
        <div class="card-custom p-4 h-100">
            <h5 class="fw-bold border-bottom pb-2 mb-3">
                <i class="bi bi-truck me-1 text-primary"></i> Branch Transfer History
            </h5>
            @if (!transfers.Any())
            {
                <p class="text-muted small text-center py-3 mb-0">This item has never been transferred between branches.</p>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var transfer in transfers)
                    {
                        <div class="list-group-item px-0">
                            <div class="d-flex justify-content-between">
                                <span class="fw-semibold">@transfer.FromBranch?.Name &rarr; @transfer.ToBranch?.Name</span>
                                <span class="badge @(transfer.Status == TransferStatus.Completed ? "bg-success" : transfer.Status == TransferStatus.Cancelled ? "bg-secondary" : transfer.Status == TransferStatus.InTransit ? "bg-warning text-dark" : "bg-primary")">@transfer.Status</span>
                            </div>
                            <div class="small text-muted">Requested @transfer.RequestedDate.ToString("d MMM yyyy")@(string.IsNullOrEmpty(transfer.RequestedBy) ? "" : " by " + transfer.RequestedBy)</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
