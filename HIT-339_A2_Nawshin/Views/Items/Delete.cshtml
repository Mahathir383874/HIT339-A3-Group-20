@model Bibliotheca.Models.Entities.Item
@{
    ViewData["Title"] = $"Delete Item - {Model.Name}";
    bool hasActiveLoans = (bool)(ViewBag.HasActiveLoans ?? false);
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card-custom p-4 p-md-5 shadow-sm border-danger border-opacity-25">
            <div class="text-center mb-4">
                <div class="d-inline-flex p-3 rounded-circle bg-danger bg-opacity-10 text-danger mb-3">
                    <i class="bi bi-trash3-fill fs-2"></i>
                </div>
                <h3 class="fw-bold text-danger">Delete Library Item?</h3>
                <p class="text-muted small">Are you sure you want to permanently remove this catalog record?</p>
            </div>

            @if (hasActiveLoans)
            {
                <div class="alert alert-warning py-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Cannot Delete Item:</strong> This item is currently checked out on an active or overdue loan. It must be returned to the library before deletion.
                </div>
            }

            <div class="bg-light p-3 rounded-3 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge-code">@Model.LibraryCode</span>
                    <span class="badge bg-secondary">@Model.ItemType</span>
                </div>
                <h5 class="fw-bold text-dark mb-1">@Model.Name</h5>
                <div class="small text-muted mb-2">Current Status: <strong>@Model.Status</strong></div>
                <div class="small text-muted">Replacement Value: <strong>$@Model.ReplacementCost.ToString("F2")</strong></div>
            </div>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    @if (!hasActiveLoans)
                    {
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i> Confirm Delete
                        </button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>
