@model Bibliotheca.Models.Entities.Music
@{
    ViewData["Title"] = $"Edit Music - {Model.Name}";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-lg-8">
        <div class="card-custom p-4 p-md-5 shadow-sm">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-4">
                <div>
                    <span class="badge bg-info-subtle text-info fw-bold text-uppercase px-2 py-1 mb-1">
                        <i class="bi bi-pencil me-1"></i> Edit Music Album
                    </span>
                    <h3 class="fw-bold mb-0">Modify Music Details</h3>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Items
                </a>
            </div>

            <form asp-action="EditMusic" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedDate" />
                <input type="hidden" asp-for="ItemType" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Name" class="form-label fw-semibold small">Album / Track Title</label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="LibraryCode" class="form-label fw-semibold small"></label>
                        <input asp-for="LibraryCode" class="form-control font-monospace" required />
                        <span asp-validation-for="LibraryCode" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Status" class="form-label fw-semibold small"></label>
                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ItemStatus>()"></select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Artist" class="form-label fw-semibold small"></label>
                        <input asp-for="Artist" class="form-control" required />
                        <span asp-validation-for="Artist" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="ReleaseYear" class="form-label fw-semibold small"></label>
                        <input asp-for="ReleaseYear" type="number" class="form-control" />
                        <span asp-validation-for="ReleaseYear" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="RecordLabel" class="form-label fw-semibold small"></label>
                        <input asp-for="RecordLabel" class="form-control" />
                        <span asp-validation-for="RecordLabel" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="DurationMinutes" class="form-label fw-semibold small"></label>
                        <input asp-for="DurationMinutes" type="number" class="form-control" />
                        <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                    </div>

                    <div class="col-12 col-md-4">
                        <label asp-for="ReplacementCost" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="ReplacementCost" type="number" step="0.01" class="form-control" />
                        </div>
                        <span asp-validation-for="ReplacementCost" class="text-danger small"></span>
                    </div>

                    <!-- Image Section: Device Upload or Web URL -->
                    <div class="col-12">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-bold text-dark small mb-0">
                                    <i class="bi bi-image me-1 text-info"></i> Album Cover Graphic / Photo
                                </label>
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle small">
                                        <i class="bi bi-check-circle me-1"></i> Current Image Set
                                    </span>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="mb-3 d-flex align-items-center gap-3">
                                    <img src="@Model.ImageUrl" alt="Current Image" class="rounded border" style="width: 70px; height: 70px; object-fit: cover;" onerror="this.style.display='none'" />
                                    <div class="small text-muted text-truncate" style="max-width: 400px;">
                                        Current path: <code>@Model.ImageUrl</code>
                                    </div>
                                </div>
                            }

                            <div class="row g-3">
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold small text-muted">Upload New Image from Device</label>
                                    <input type="file" name="imageFile" class="form-control" accept="image/*" />
                                    <div class="form-text small">Upload to replace existing image.</div>
                                </div>

                                <div class="col-12 col-md-6">
                                    <label asp-for="ImageUrl" class="form-label fw-semibold small text-muted">Or Update Image Web URL</label>
                                    <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/album-art.jpg" />
                                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom px-4">
                        <i class="bi bi-save me-1"></i> Update Music Item
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
