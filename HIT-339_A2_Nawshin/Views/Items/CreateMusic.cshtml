@model Bibliotheca.Models.Entities.Music
@{
    ViewData["Title"] = "Add New Music Album";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-lg-8">
        <div class="card-custom p-4 p-md-5 shadow-sm">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-4">
                <div>
                    <span class="badge bg-info-subtle text-info fw-bold text-uppercase px-2 py-1 mb-1">
                        <i class="bi bi-disc me-1"></i> New Music Record
                    </span>
                    <h3 class="fw-bold mb-0">Add Music to Catalog</h3>
                </div>
                <a asp-action="Index" asp-route-category="Music" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Items
                </a>
            </div>

            <form asp-action="CreateMusic" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row g-3">
                    <!-- Title -->
                    <div class="col-12">
                        <label asp-for="Name" class="form-label fw-semibold small">Album / Track Title</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Abbey Road" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Library Code -->
                    <div class="col-12 col-md-6">
                        <label asp-for="LibraryCode" class="form-label fw-semibold small"></label>
                        <input asp-for="LibraryCode" class="form-control font-monospace" placeholder="e.g. MUS-2005" required />
                        <div class="form-text small">Regex format: <code>^[A-Z]{3}-\d{4}$</code>.</div>
                        <span asp-validation-for="LibraryCode" class="text-danger small"></span>
                    </div>

                    <!-- Status -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Status" class="form-label fw-semibold small"></label>
                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ItemStatus>()"></select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <!-- Artist -->
                    <div class="col-12 col-md-6">
                        <label asp-for="Artist" class="form-label fw-semibold small"></label>
                        <input asp-for="Artist" class="form-control" placeholder="e.g. The Beatles, Miles Davis" required />
                        <span asp-validation-for="Artist" class="text-danger small"></span>
                    </div>

                    <!-- Release Year -->
                    <div class="col-12 col-md-6">
                        <label asp-for="ReleaseYear" class="form-label fw-semibold small"></label>
                        <input asp-for="ReleaseYear" type="number" class="form-control" placeholder="e.g. 1969" />
                        <span asp-validation-for="ReleaseYear" class="text-danger small"></span>
                    </div>

                    <!-- Record Label -->
                    <div class="col-12 col-md-4">
                        <label asp-for="RecordLabel" class="form-label fw-semibold small"></label>
                        <input asp-for="RecordLabel" class="form-control" placeholder="e.g. Apple Records" />
                        <span asp-validation-for="RecordLabel" class="text-danger small"></span>
                    </div>

                    <!-- Duration -->
                    <div class="col-12 col-md-4">
                        <label asp-for="DurationMinutes" class="form-label fw-semibold small"></label>
                        <input asp-for="DurationMinutes" type="number" class="form-control" placeholder="e.g. 45" />
                        <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                    </div>

                    <!-- Replacement Cost -->
                    <div class="col-12 col-md-4">
                        <label asp-for="ReplacementCost" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="ReplacementCost" type="number" step="0.01" class="form-control" />
                        </div>
                        <span asp-validation-for="ReplacementCost" class="text-danger small"></span>
                    </div>

                    <!-- Image Section: Device Upload or Web URL -->
                    <div class="col-12">
                        <div class="p-3 bg-light rounded-3 border">
                            <label class="form-label fw-bold text-dark small d-block mb-2">
                                <i class="bi bi-image me-1 text-info"></i> Album Cover Graphic / Photo
                            </label>
                            
                            <div class="row g-3">
                                <!-- Upload from Device -->
                                <div class="col-12 col-md-6">
                                    <label class="form-label fw-semibold small text-muted">Option A: Upload Image from Device</label>
                                    <input type="file" name="imageFile" class="form-control" accept="image/*" />
                                    <div class="form-text small">Select JPEG, PNG, or WebP image from your computer.</div>
                                </div>

                                <!-- Or Provide Web URL -->
                                <div class="col-12 col-md-6">
                                    <label asp-for="ImageUrl" class="form-label fw-semibold small text-muted">Option B: Or Enter Image Web URL</label>
                                    <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/album-art.jpg" />
                                    <div class="form-text small">Provide a direct web link if not uploading from device.</div>
                                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold small"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Album tracks, genre or producer details..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" asp-route-category="Music" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom px-4">
                        <i class="bi bi-check-lg me-1"></i> Save Music Album
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
