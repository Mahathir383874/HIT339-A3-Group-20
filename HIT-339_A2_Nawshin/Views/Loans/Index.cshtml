@model IEnumerable<Bibliotheca.Models.Entities.Loan>
@{
    ViewData["Title"] = "Circulation Desk - Loans";
    var activeFilter = (string)ViewBag.ActiveFilter ?? "Active";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <span class="badge role-reception mb-1"><i class="bi bi-arrow-left-right me-1"></i> Reception Desk</span>
        <h2 class="fw-bold mb-0">Circulation & Lending Records</h2>
        <p class="text-muted small mb-0">Track active checkouts, overdue items, returns, and late fee calculations.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Issue" class="btn btn-primary-custom">
            <i class="bi bi-box-arrow-right me-1"></i> Issue Item
        </a>
        <a asp-action="Fines" class="btn btn-outline-custom">
            <i class="bi bi-cash-coin me-1"></i> Fines Desk
        </a>
    </div>
</div>

<!-- Tabs & Search Filter -->
<div class="card-custom p-3 mb-4">
    <div class="row g-3 align-items-center justify-content-between">
        <!-- Filter Tabs -->
        <div class="col-12 col-md-auto">
            <ul class="nav nav-pills">
                <li class="nav-item">
                    <a class="nav-link @(activeFilter == "Active" ? "active" : "")" asp-action="Index" asp-route-filter="Active">
                        <i class="bi bi-clock-history me-1"></i> Active Loans
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeFilter == "Overdue" ? "active bg-danger" : "text-danger")" asp-action="Index" asp-route-filter="Overdue">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Overdue Only
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeFilter == "Returned" ? "active" : "")" asp-action="Index" asp-route-filter="Returned">
                        <i class="bi bi-check2-circle me-1"></i> Returned History
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(activeFilter == "All" ? "active" : "")" asp-action="Index" asp-route-filter="All">
                        All Records
                    </a>
                </li>
            </ul>
        </div>

        <!-- Search Input -->
        <div class="col-12 col-md-5">
            <form asp-action="Index" method="get" class="d-flex gap-2">
                <input type="hidden" name="filter" value="@activeFilter" />
                <div class="input-group">
                    <input type="text" name="searchTerm" class="form-control form-control-sm" placeholder="Search by item code, title, borrower..." value="@ViewBag.SearchTerm" />
                    <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
                </div>
                @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
                {
                    <a asp-action="Index" asp-route-filter="@activeFilter" class="btn btn-sm btn-outline-danger" title="Clear">
                        <i class="bi bi-x"></i>
                    </a>
                }
            </form>
        </div>
    </div>
</div>

<!-- Loans Table -->
<div class="card-custom overflow-hidden shadow-sm">
    <div class="table-responsive">
        <table class="table table-custom align-middle">
            <thead>
                <tr>
                    <th>Item Code & Title</th>
                    <th>Borrower</th>
                    <th>Date Issued</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Fines</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-journal-x fs-2 d-block mb-2"></i>
                            No loan transactions found in this view.
                        </td>
                    </tr>
                }
                @foreach (var loan in Model)
                {
                    var isOverdue = loan.Status == LoanStatus.Overdue || (loan.Status == LoanStatus.Active && loan.DueDate < DateTime.UtcNow);

                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge-code">@loan.Item?.LibraryCode</span>
                                <div>
                                    <div class="fw-bold text-dark text-truncate" style="max-width: 260px;" title="@loan.Item?.Name">
                                        @loan.Item?.Name
                                    </div>
                                    <span class="badge badge-type">@loan.Item?.ItemType</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">@loan.Borrower?.FullName</div>
                            <span class="badge bg-light text-secondary border font-monospace">@loan.Borrower?.CardNumber</span>
                        </td>
                        <td>
                            <span class="small text-muted">@loan.BorrowDate.ToString("d MMM yyyy")</span>
                        </td>
                        <td>
                            <div class="small @(isOverdue ? "text-danger fw-bold" : "text-dark")">
                                @loan.DueDate.ToString("d MMM yyyy")
                            </div>
                            @if (isOverdue && loan.Status != LoanStatus.Returned)
                            {
                                var daysLate = (int)Math.Ceiling((DateTime.UtcNow - loan.DueDate).TotalDays);
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">
                                    @daysLate days late ($@(daysLate * 1.00m) fine)
                                </span>
                            }
                        </td>
                        <td>
                            @if (loan.Status == LoanStatus.Returned)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                    <i class="bi bi-check-circle me-1"></i> Returned
                                </span>
                            }
                            else if (isOverdue)
                            {
                                <span class="badge bg-danger px-2 py-1">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Overdue
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                    <i class="bi bi-clock me-1"></i> Active
                                </span>
                            }
                        </td>
                        <td>
                            @if (loan.Fine != null)
                            {
                                <span class="badge @(loan.Fine.IsPaid ? "bg-success" : "bg-danger")">
                                    $@loan.Fine.Amount.ToString("F2") (@(loan.Fine.IsPaid ? "Paid" : "Unpaid"))
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">$0.00</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (loan.Status != LoanStatus.Returned)
                            {
                                <a asp-action="Return" asp-route-id="@loan.Id" class="btn btn-sm btn-success">
                                    <i class="bi bi-box-arrow-in-left me-1"></i> Return
                                </a>
                            }
                            else
                            {
                                <span class="text-muted small">
                                    Ret. @(loan.ReturnDate.HasValue ? loan.ReturnDate.Value.ToString("d MMM") : "")
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
