@model Bibliotheca.Models.ViewModels.IssueLoanViewModel
@{
    ViewData["Title"] = "Issue Item to Borrower";
}

<div class="row justify-content-center py-3">
    <div class="col-12 col-lg-8">
        <div class="card-custom p-4 p-md-5 shadow-sm">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-4">
                <div>
                    <span class="badge role-reception fw-bold text-uppercase px-2 py-1 mb-1">
                        <i class="bi bi-box-arrow-right me-1"></i> Loan Desk Check-out
                    </span>
                    <h3 class="fw-bold mb-0">Issue Library Item</h3>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Loans
                </a>
            </div>

            <form asp-action="Issue" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row g-3">
                    <!-- Borrower Card Number -->
                    <div class="col-12 col-md-6">
                        <label asp-for="CardNumber" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-person-vcard text-muted"></i></span>
                            <input asp-for="CardNumber" id="cardNumberInput" class="form-control font-monospace" placeholder="e.g. CRD-1001" required />
                        </div>
                        <span asp-validation-for="CardNumber" class="text-danger small"></span>

                        @if (Model.ActiveBorrowers != null && Model.ActiveBorrowers.Any())
                        {
                            <div class="mt-1">
                                <label class="text-muted small">Or select existing patron:</label>
                                <select class="form-select form-select-sm" onchange="document.getElementById('cardNumberInput').value = this.value">
                                    <option value="">-- Choose Patron --</option>
                                    @foreach (var b in Model.ActiveBorrowers)
                                    {
                                        <option value="@b.CardNumber">@b.FullName (@b.CardNumber)</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>

                    <!-- Item Library Code -->
                    <div class="col-12 col-md-6">
                        <label asp-for="LibraryCode" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-upc-scan text-muted"></i></span>
                            <input asp-for="LibraryCode" id="libraryCodeInput" class="form-control font-monospace" placeholder="e.g. BOK-1001" required />
                        </div>
                        <span asp-validation-for="LibraryCode" class="text-danger small"></span>

                        @if (Model.AvailableItems != null && Model.AvailableItems.Any())
                        {
                            <div class="mt-1">
                                <label class="text-muted small">Or select available catalog item:</label>
                                <select class="form-select form-select-sm" onchange="document.getElementById('libraryCodeInput').value = this.value">
                                    <option value="">-- Choose Available Item --</option>
                                    @foreach (var item in Model.AvailableItems)
                                    {
                                        <option value="@item.LibraryCode">[@item.LibraryCode] @item.Name (@item.ItemType)</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>

                    <!-- Loan Period -->
                    <div class="col-12 col-md-6 mt-3">
                        <label asp-for="LoanDays" class="form-label fw-semibold small"></label>
                        <select asp-for="LoanDays" class="form-select">
                            <option value="7">7 Days (Short Loan)</option>
                            <option value="14" selected>14 Days (Standard Loan)</option>
                            <option value="21">21 Days (Extended Loan)</option>
                            <option value="28">28 Days (Monthly Loan)</option>
                        </select>
                        <span asp-validation-for="LoanDays" class="text-danger small"></span>
                    </div>

                    <!-- Remarks -->
                    <div class="col-12 col-md-6 mt-3">
                        <label asp-for="Remarks" class="form-label fw-semibold small"></label>
                        <input asp-for="Remarks" class="form-control" placeholder="Optional circulation notes..." />
                        <span asp-validation-for="Remarks" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom px-4">
                        <i class="bi bi-check2-circle me-1"></i> Confirm Issue
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
