@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bibliotheca LMS</title>
    
    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- Custom Application CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <!-- Chart.js for Manager Statistics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container-fluid px-lg-4">
                <!-- Brand Logo -->
                <a class="brand-logo" asp-controller="Catalog" asp-action="Index">
                    <i class="bi bi-book-half text-primary"></i>
                    <span>Bibliotheca</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2 text-dark"></i>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <!-- Left Navigation: Public & Role-Specific Links -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <!-- Public Catalog Search -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Catalog" asp-action="Index">
                                <i class="bi bi-search me-1"></i> Public Catalog
                            </a>
                        </li>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-collection me-1 text-danger"></i> Item Management
                                    </a>
                                    <ul class="dropdown-menu shadow-sm border-0">
                                        <li><a class="dropdown-item" asp-controller="Items" asp-action="Index"><i class="bi bi-grid me-2"></i>All Catalog Items</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Items" asp-action="CreateBook"><i class="bi bi-journal-plus me-2 text-primary"></i>Add New Book</a></li>
                                        <li><a class="dropdown-item" asp-controller="Items" asp-action="CreateMusic"><i class="bi bi-disc me-2 text-info"></i>Add New Music</a></li>
                                        <li><a class="dropdown-item" asp-controller="Items" asp-action="CreateToy"><i class="bi bi-puzzle me-2 text-warning"></i>Add New Toy</a></li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("Reception") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-arrow-left-right me-1 text-primary"></i> Desk Circulation
                                    </a>
                                    <ul class="dropdown-menu shadow-sm border-0">
                                        <li><a class="dropdown-item" asp-controller="Loans" asp-action="Index"><i class="bi bi-journal-check me-2"></i>Active Loans & History</a></li>
                                        <li><a class="dropdown-item" asp-controller="Loans" asp-action="Issue"><i class="bi bi-box-arrow-right me-2 text-success"></i>Issue / Borrow Item</a></li>
                                        <li><a class="dropdown-item" asp-controller="Loans" asp-action="Fines"><i class="bi bi-cash-coin me-2 text-warning"></i>Late Fines Management</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Borrowers" asp-action="Index"><i class="bi bi-people me-2"></i>Borrower Profiles</a></li>
                                        <li><a class="dropdown-item" asp-controller="Borrowers" asp-action="Create"><i class="bi bi-person-plus me-2 text-success"></i>Register New Borrower</a></li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Manager" asp-action="Index">
                                        <i class="bi bi-graph-up-arrow me-1 text-warning"></i> Manager Statistics
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <!-- Right Navigation: Authentication State -->
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var userRole = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Reception") ? "Reception" : User.IsInRole("Manager") ? "Manager" : "Staff";
                            var roleBadgeClass = User.IsInRole("Admin") ? "role-admin" : User.IsInRole("Reception") ? "role-reception" : "role-manager";

                            <li class="nav-item d-flex align-items-center">
                                <span class="nav-badge-role @roleBadgeClass me-2">
                                    <i class="bi bi-shield-lock-fill me-1"></i>@userRole
                                </span>
                                <span class="fw-semibold text-dark small me-3">
                                    @User.Identity?.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger px-3 py-1">
                                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-primary-custom" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-person-lock me-1"></i> Staff Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Body Container -->
    <main role="main" class="container-fluid px-lg-5 py-4 flex-grow-1">
        <!-- Flash Alert Messages -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-custom alert-dismissible fade show shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-custom alert-dismissible fade show shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning alert-custom alert-dismissible fade show shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i> @TempData["WarningMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-custom alert-dismissible fade show shadow-sm mb-4" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> @TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <!-- CLEAN & ELEGANT LIGHT FOOTER -->
    <footer class="footer-clean">
        <div class="container-fluid px-lg-5 py-3">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 text-center text-md-start">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-book-half text-primary fs-5"></i>
                    <span class="fw-bold text-dark">Bibliotheca</span>
                    <span class="text-muted small">&copy; 2026 Library Management System &bull; HIT339</span>
                </div>
                <div class="small text-muted d-flex align-items-center gap-2 flex-wrap justify-content-center">
                    <span class="badge bg-light text-secondary border px-2 py-1">
                        <i class="bi bi-person-fill text-primary me-1"></i>Nawshin Nawar Tanisha (S383856)
                    </span>
                    <span>Roles: Admin &bull; Reception &bull; Manager</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
