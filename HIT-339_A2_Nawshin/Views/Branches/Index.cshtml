@model List<Bibliotheca.Models.ViewModels.BranchSummaryRow>
@{
    ViewData["Title"] = "Library Branches";
    var isAdmin = User.IsInRole("Admin");
    int unassigned = ViewBag.UnassignedItems is int count ? count : 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <span class="badge role-reception mb-1"><i class="bi bi-building me-1"></i> Multi-Branch Inventory</span>
        <h2 class="fw-bold mb-0">Library Branches</h2>
        <p class="text-muted small mb-0">Every catalogue item is held at one branch. Open a branch to see its inventory.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Inventory" class="btn btn-outline-custom"><i class="bi bi-boxes me-1"></i> All inventory</a>
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-primary-custom"><i class="bi bi-plus-circle me-1"></i> Add Branch</a>
        }
    </div>
</div>

@if (unassigned > 0)
{
    <div class="alert alert-warning small"><i class="bi bi-exclamation-triangle me-1"></i> @unassigned item(s) are not assigned to a branch yet. Edit them in Item Management to choose a branch.</div>
}

<div class="row g-3">
    @foreach (var row in Model)
    {
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card-custom p-4 h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h5 class="fw-bold mb-0">@row.Branch.Name</h5>
                        <span class="badge-code">@row.Branch.Code</span>
                    </div>
                    @if (row.Branch.IsActive)
                    {
                        <span class="badge bg-success">Open</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Closed</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(row.Branch.Address))
                {
                    <div class="small text-muted mb-3"><i class="bi bi-geo-alt me-1"></i>@row.Branch.Address</div>
                }
                <div class="row text-center g-2 mb-3">
                    <div class="col-3"><div class="fw-bold fs-5">@row.Total</div><div class="small text-muted">Items</div></div>
                    <div class="col-3"><div class="fw-bold fs-5 text-success">@row.Available</div><div class="small text-muted">Available</div></div>
                    <div class="col-3"><div class="fw-bold fs-5 text-primary">@row.Borrowed</div><div class="small text-muted">On loan</div></div>
                    <div class="col-3"><div class="fw-bold fs-5 text-danger">@(row.Damaged + row.Destroyed)</div><div class="small text-muted">Damaged</div></div>
                </div>
                <div class="small text-muted mb-3">
                    <i class="bi bi-box-arrow-in-down me-1"></i>@row.IncomingTransfers incoming
                    <i class="bi bi-box-arrow-up-right ms-3 me-1"></i>@row.OutgoingTransfers outgoing transfer(s)
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Inventory" asp-route-branchId="@row.Branch.Id" class="btn btn-sm btn-outline-custom"><i class="bi bi-boxes me-1"></i> Inventory</a>
                    <a asp-controller="Transfers" asp-action="Index" asp-route-branchId="@row.Branch.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-truck me-1"></i> Transfers</a>
                    @if (isAdmin)
                    {
                        <a asp-action="Edit" asp-route-id="@row.Branch.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil me-1"></i> Edit</a>
                    }
                </div>
            </div>
        </div>
    }
</div>
